# Copy this file to .env.local and fill in the values

# Keycloak Configuration
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=calendarun
KEYCLOAK_CLIENT_ID=calendarun-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8180/realms/calendarun
# Client-side access (for logout redirect to Keycloak end-session)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/calendarun
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=calendarun
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=calendarun-web

# Keycloak Admin API (service account)
KEYCLOAK_ADMIN_CLIENT_ID=calendarun-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=calendarun

# App URL (used for cookie security + reset links)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
NEXT_PUBLIC_BFF_URL=

# Password Reset
RESET_TOKEN_TTL_MINUTES=30

# SMTP (password reset email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@calendarun.local
