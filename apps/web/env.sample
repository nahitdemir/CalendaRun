# Copy this file to .env.local and fill in the values

# Keycloak Configuration
KEYCLOAK_CLIENT_ID=calendarun-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8180/realms/calendarun
# Client-side access (for logout redirect to Keycloak end-session)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/calendarun

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

