{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/calendarun"
  },
  "PlatformApi": {
    "BaseUrl": "http://localhost:5401"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-events": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "planning": {
        "ClusterId": "planning",
        "Match": {
          "Path": "/api/plan/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "settings": {
        "ClusterId": "settings",
        "Match": {
          "Path": "/api/settings/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "platform-tenants": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      },
      "platform-memberships": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/memberships/{**catch-all}"
        }
      },
      "platform-invites": {
        "ClusterId": "platform",
        "Match": {
          "Path": "/api/invites/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "planning": {
        "Destinations": {
          "planning-api": {
            "Address": "http://localhost:5201"
          }
        }
      },
      "settings": {
        "Destinations": {
          "settings-api": {
            "Address": "http://localhost:5301"
          }
        }
      },
      "platform": {
        "Destinations": {
          "platform-api": {
            "Address": "http://localhost:5401"
          }
        }
      }
    }
  }
}
