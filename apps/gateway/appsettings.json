{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "events-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/events"
        },
        "Transforms": [
          { "PathPattern": "/events" }
        ]
      },
      "plan-route": {
        "ClusterId": "planning-cluster",
        "Match": {
          "Path": "/api/plan"
        },
        "Transforms": [
          { "PathPattern": "/plan" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "planning-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5201"
          }
        }
      }
    }
  }
}
